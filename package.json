{
  "name": "3dgame",
  "version": "0.1.0",
  "private": true,
  "description": "Smooth 3D MMORPG character-movement prototype (Babylon.js + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "catalog": "python3 tools/nature_catalog.py",
    "convert:character": "python3 tools/fbx_to_glb.py \"assets/Fantasy_Heroes_Free/FBX/Characters/Hero.fbx\" \"assets/Fantasy_Heroes_Free/Texture/Texture.png\" public/models/hero.glb"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/loaders": "^7.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
